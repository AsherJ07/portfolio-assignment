# Public canonical URL used for metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact delivery is intentionally disabled until a provider is approved.
# Resend API key used only by the server route. Never expose this value publicly.
RESEND_API_KEY=

# Verified sender identity accepted by the delivery provider.
CONTACT_FROM_EMAIL=

# Private destination that receives portfolio form submissions.
CONTACT_TO_EMAIL=
